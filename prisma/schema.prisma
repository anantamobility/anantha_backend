// do this later. pure ops
model Service {
  id                               String           @id @default(uuid(7))
  serviceNumber                    String           @unique
  vehicleId                        String
  vehicle                          Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId                         String?
  rental                           Rental?          @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceType                      ServiceType
  status                           ServiceStatus    @default(REPORTED)
  responsibleParty                 ResponsibleParty @default(UNKNOWN)
  reportedById                     String?
  reportedBy                       User?            @relation("ServiceReportedBy", fields: [reportedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedById                     String?
  approvedBy                       User?            @relation("ServiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedToId                     String?
  assignedTo                       User?            @relation("ServiceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportedAt                       DateTime         @default(now()) @db.Timestamptz(3)
  startedAt                        DateTime?        @db.Timestamptz(3)
  completedAt                      DateTime?        @db.Timestamptz(3)
  closedAt                         DateTime?        @db.Timestamptz(3)
  cancelledAt                      DateTime?        @db.Timestamptz(3)
  cancellationReason               String?
  downtimeStart                    DateTime?        @db.Timestamptz(3)
  downtimeEnd                      DateTime?        @db.Timestamptz(3)
  downtimeReason                   String?
  previousVehicleStatus            VehicleStatus?
  description                      String?
  diagnosis                        String?
  repairNotes                      String?
  resolutionNotes                  String?
  responsibilityApprovedAt         DateTime?        @db.Timestamptz(3)
  responsibilityInvestigationNotes String?
  responsibilityEvidence           Json?            @db.JsonB
  replacementVehicleId             String?
  replacementVehicle               Vehicle?         @relation("ReplacementVehicle", fields: [replacementVehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version                          Int              @default(0)
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt

  charges                ServiceCharge[]
  spares                 ServiceSpare[]
  inventoryMovements     InventoryMovement[]
  // statusHistory           ServiceStatusHistory[]
  // responsibilityApprovals ServiceResponsibilityApproval[]
  replacementAssignments ReplacementAssignment[]
  rentalPause            RentalPause?

  @@index([vehicleId, status])
  @@index([rentalId])
  @@index([reportedAt])
  @@index([replacementVehicleId])
  @@index([status])
  @@map("services")
}

model ServiceCharge {
  id              String              @id @default(uuid(7))
  serviceId       String
  service         Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chargeType      ServiceChargeType
  costAmount      Decimal             @db.Decimal(14, 2)
  billableAmount  Decimal             @default(0) @db.Decimal(14, 2)
  recoverableFrom ResponsibleParty    @default(AML)
  status          ServiceChargeStatus @default(PENDING)
  currency        String              @default("INR") @db.Char(3)
  description     String?
  sourceType      String?
  sourceId        String?
  idempotencyKey  String?             @unique
  serviceSpareId  String?             @unique
  serviceSpare    ServiceSpare?       @relation(fields: [serviceSpareId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  invoiceLine InvoiceLine?

  @@index([serviceId])
  @@index([sourceType, sourceId])
  @@map("service_charges")
}

model ServiceSpare {
  id                  String             @id @default(uuid(7))
  serviceId           String
  service             Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  spareId             String
  spare               Spare              @relation(fields: [spareId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity            Int
  unitCost            Decimal            @db.Decimal(14, 4)
  lineCost            Decimal            @db.Decimal(14, 2)
  idempotencyKey      String?            @unique
  inventoryMovementId String?            @unique
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt           DateTime           @default(now())

  charge ServiceCharge?

  @@index([serviceId])
  @@index([spareId])
  @@map("service_spares")
}

model RentalPause {
  id                   String            @id @default(uuid(7))
  rentalId             String
  rental               Rental            @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceId            String            @unique
  service              Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status               RentalPauseStatus @default(ACTIVE)
  previousRentalStatus RentalStatus
  pausedAt             DateTime          @db.Timestamptz(3)
  resumedAt            DateTime?         @db.Timestamptz(3)
  reason               String?
  pausedById           String?
  pausedBy             User?             @relation("RentalPausedBy", fields: [pausedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resumedById          String?
  resumedBy            User?             @relation("RentalResumedBy", fields: [resumedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([rentalId, status])
  @@index([rentalId, pausedAt])
  @@map("rental_pauses")
}

model ReplacementAssignment {
  id                   String           @id @default(uuid(7))
  serviceId            String
  service              Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  originalVehicleId    String
  originalVehicle      Vehicle          @relation("ReplacementOriginalVehicle", fields: [originalVehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacementVehicleId String
  replacementVehicle   Vehicle          @relation("ReplacementAssignedVehicle", fields: [replacementVehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId             String?
  rental               Rental?          @relation("ReplacementOriginalRental", fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacementRentalId  String?
  replacementRental    Rental?          @relation("ReplacementRental", fields: [replacementRentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderId              String?
  rider                Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clientId             String?
  client               Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status               AssignmentStatus @default(ACTIVE)
  assignedAt           DateTime         @default(now()) @db.Timestamptz(3)
  returnedAt           DateTime?        @db.Timestamptz(3)
  assignedById         String?
  assignedBy           User?            @relation("ReplacementAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  returnedById         String?
  returnedBy           User?            @relation("ReplacementReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reason               String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([serviceId, status])
  @@index([replacementVehicleId, status])
  @@index([originalVehicleId])
  @@index([rentalId])
  @@index([replacementRentalId])
  @@map("replacement_assignments")
}

model Spare {
  id            String   @id @default(uuid(7))
  partNumber    String   @unique
  name          String
  category      String?
  description   String?
  unitOfMeasure String   @default("UNIT")
  purchasePrice Decimal? @db.Decimal(14, 4)
  unitCost      Decimal  @db.Decimal(14, 4)
  minimumStock  Int      @default(0)
  currency      String   @default("INR") @db.Char(3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances      InventoryBalance[]
  movements     InventoryMovement[]
  serviceSpares ServiceSpare[]

  @@index([name])
  @@index([category])
  @@index([isActive])
  @@map("spares")
}

model InventoryBalance {
  id        String   @id @default(uuid(7))
  spareId   String
  spare     Spare    @relation(fields: [spareId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hubId     String
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([spareId, hubId])
  @@index([hubId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id             String                @id @default(uuid(7))
  spareId        String
  spare          Spare                 @relation(fields: [spareId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movementType   InventoryMovementType
  quantity       Int
  quantityDelta  Int
  unitCost       Decimal?              @db.Decimal(14, 4)
  hubId          String?
  hub            Hub?                  @relation("MovementHub", fields: [hubId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromHubId      String?
  fromHub        Hub?                  @relation("MovementFromHub", fields: [fromHubId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toHubId        String?
  toHub          Hub?                  @relation("MovementToHub", fields: [toHubId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceId      String?
  service        Service?              @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicleId      String?
  vehicle        Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movedById      String?
  movedBy        User?                 @relation("InventoryMovedBy", fields: [movedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referenceType  String?
  referenceId    String?
  idempotencyKey String?               @unique
  notes          String?
  movedAt        DateTime              @default(now()) @db.Timestamptz(3)
  createdAt      DateTime              @default(now())

  serviceSpare ServiceSpare?

  @@index([spareId, movedAt])
  @@index([spareId, hubId, movedAt])
  @@index([fromHubId])
  @@index([toHubId])
  @@index([serviceId])
  @@index([vehicleId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

