  referenceType  String? //add enum
  referenceId    String?
  snapshot       Json?                @db.JsonB
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  @@index([payStatementId])
  @@index([rentalId])
  @@index([ledgerEntryId])
  @@map("rider_pay_statement_lines")
}

