/**
 * Rent collections settle a rental due. Deposit collections have no due.
 * CHECK ( (purpose = 'RENT' AND rental_due_id IS NOT NULL) OR (purpose = 'DEPOSIT' AND rental_due_id IS NULL) )
 */
model Collection {
  id              String              @id @default(uuid(7))
  purpose         CollectionPurpose   @default(RENT)
  payerType       CollectionPayerType
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId         String?
  rider           Rider?              @relation(fields: [riderId], references: [id], onDelete: Restrict)
  rentalDueId     String?
  rentalDue       RentalDue?          @relation(fields: [rentalDueId], references: [id], onDelete: Restrict)
  amount          Decimal             @db.Decimal(14, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  receivedAt      DateTime            @default(now()) @db.Timestamptz(3)
  receivedById    String?
  receivedBy      User?               @relation("CollectionReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  notes           String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  depositLedgerEntries DepositLedger[]

  @@index([clientId, receivedAt])
  @@index([riderId, receivedAt])
  @@index([rentalDueId])
  @@map("collections")
}

//p
model RentalDue {
  id                String          @id @default(uuid(7))
  rentalId          String
  rental            Rental          @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  periodStart       DateTime        @db.Timestamptz(3)
  periodEnd         DateTime        @db.Timestamptz(3)
  dueDate           DateTime        @db.Timestamptz(3)
  amountDue         Decimal         @db.Decimal(14, 2)
  amountCollected   Decimal         @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal         @db.Decimal(14, 2) //amount to be collected
  status            RentalDueStatus @default(PENDING)
  generatedAt       DateTime        @default(now()) @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  collections Collection[]

  @@unique([rentalId, periodStart, periodEnd])
  @@index([rentalId, status, dueDate])
  @@index([status, dueDate])
  @@map("rental_dues")
}

/**
 * ALTER TABLE ledger_entries ADD CONSTRAINT ledger_entries_party_chk
 * CHECK (rental_id IS NOT NULL OR rider_id IS NOT NULL);
 * Append-only money journal. One row per movement, never edited:
 * - rental side (client/rider owes AML): rentalId set
 * - rider side (AML owes rider): riderId set, payStatementId when closed out
 * One economic event can still be two rows.
 * When rent is deducted from rider pay,
 * payStatement code writes RENT_DEDUCTION (rider, DEBIT)
 * and COLLECTION_RECEIVED (rental, CREDIT) for the same amount.
 * penalties, incentives, reimbursements are all just entries with a type
 * and direction until a statement claims them.
 */
model LedgerEntry {
  id          String          @id @default(uuid(7))
  entryType   LedgerEntryType
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(14, 2)
  occurredAt  DateTime        @db.Timestamptz(3)
  description String

  rentalId       String?
  rental         Rental?            @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  riderId        String?
  rider          Rider?             @relation(fields: [riderId], references: [id], onDelete: Restrict)
  payStatementId String?
  payStatement   RiderPayStatement? @relation(fields: [payStatementId], references: [id], onDelete: Restrict)

  //It is a soft pointer to the business row that caused the entry. sourceType says what kind of row, sourceId says which one.
  sourceType      String?   
  sourceId        String?
  reversesEntryId String?      @unique
  reversesEntry   LedgerEntry? @relation("LedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      LedgerEntry? @relation("LedgerEntryReversal")

  createdById    String?
  createdBy      User?    @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  payStatementLines RiderPayStatementLine[]

  @@index([rentalId, occurredAt])
  @@index([riderId, occurredAt])
  @@index([payStatementId])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

model RiderPayStatement {
  id                   String             @id @default(uuid(7))
  statementNumber      String             @unique
  riderId              String
  rider                Rider              @relation(fields: [riderId], references: [id], onDelete: Restrict)
  periodStart          DateTime           @db.Timestamptz(3)
  periodEnd            DateTime           @db.Timestamptz(3)
  status               PayStatementStatus @default(DRAFT)
  grossCredits         Decimal            @default(0) @db.Decimal(14, 2)
  totalDeductions      Decimal            @default(0) @db.Decimal(14, 2)
  netPayable           Decimal            @default(0) @db.Decimal(14, 2)
  shortfallAmount      Decimal            @default(0) @db.Decimal(14, 2) //increase if deductions exceed credits
  requiresManualReview Boolean            @default(false)
  calculationSnapshot  Json?              @db.JsonB
  approvedById         String?
  approvedBy           User?              @relation("PayStatementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt           DateTime?          @db.Timestamptz(3)
  paidById             String?
  paidBy               User?              @relation("PayStatementPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  paidAt               DateTime?          @db.Timestamptz(3)
  paymentMethod        PaymentMethod?
  referenceNumber      String?
  failureReason        String?
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  lines                RiderPayStatementLine[]
  ledgerEntries        LedgerEntry[]
  depositLedgerEntries DepositLedger[]         @relation("DepositPayStatement")

  @@index([riderId, periodStart, periodEnd])
  @@index([status])
  @@map("rider_pay_statements")
}

//p
model RiderPayStatementLine {
  id             String               @id @default(uuid(7))
  payStatementId String
  payStatement   RiderPayStatement    @relation(fields: [payStatementId], references: [id], onDelete: Restrict)
