generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================
enum AccountStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum ClientType {
  INDIVIDUAL
  CORPORATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RentalType {
  B2C
  B2B
}

enum B2CMode {
  AML_RIDER
  INDIVIDUAL_RIDER
}

enum B2BRiderMgmt {
  CLIENT_MANAGED
  AML_MANAGED
}

enum BillingFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

// Collection period is intentionally separate from BillingFrequency. A rental
// may be billed daily but collected every 15 days, for example.
enum CollectionPeriod {
  WEEKLY
  EVERY_15_DAYS
  MONTHLY
}

enum RentalDueStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum RentalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  COMPLETED
  TERMINATED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  CANCELLED
}

enum VehicleStatus {
  IDLE
  DEPLOYED
  IN_SERVICE
  UNDER_REPAIR
  OUT_OF_SERVICE
  RETIRED
}

enum RiderStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  INACTIVE
  TERMINATED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DepositPayerType {
  CLIENT
  RIDER
}

enum DepositStatus {
  REQUIRED
  PENDING_RECEIPT
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
  CLOSED
}

enum DepositTransactionType {
  RECEIPT
  REFUND
  DEDUCTION
  FORFEIT
  ADJUSTMENT
  REVERSAL
}

enum InvoiceKind {
  CONSOLIDATED
  RENTAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum ChargeType {
  RENTAL
  SERVICE
  REPAIR
  REPLACEMENT
  PARTS
  DOWNTIME
  ADJUSTMENT
  CREDIT
  OTHER
}

enum CollectionPayerType {
  CLIENT
  RIDER
}

enum CollectionStatus {
  PENDING
  CLEARED
  FAILED
  REFUNDED
  REVERSED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  PAYABLE
  APPROVED
  PAID
  FAILED
  RECONCILED
  REVERSED
}

enum SettlementLineType {
  DELIVERY_EARNING
  RENT_DEDUCTION
  DEPOSIT_DEDUCTION
  ADJUSTMENT
  OTHER_DEDUCTION
  PAYOUT_REVERSAL
}

// One ledger for both directions: money owed to AML by a client/rider
// (rent) and money owed by AML to a rider (earnings). entryType says which.
enum LedgerEntryType {
  RENT_CHARGED
  COLLECTION_RECEIVED
  RENT_ADJUSTMENT
  DELIVERY_EARNING
  RENT_DEDUCTION
  DEPOSIT_DEDUCTION
  ADJUSTMENT
  PAYOUT
  REVERSAL
  OTHER
}

// need to work on this later
enum LedgerDirection {
  CREDIT // rental side: amonut recieved. rider side: AML owes more
  DEBIT // rental side: cutomer owns more. rider side: paid/deducted
}

enum ServiceType {
  TECHNICAL
  PREVENTIVE
  ACCIDENT
  RIDER_DAMAGE
  OTHER
}

enum ServiceStatus {
  REPORTED
  APPROVED
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CLOSED
  CANCELLED
}

enum ResponsibleParty {
  AML
  RIDER
  CLIENT
  THIRD_PARTY
  INSURANCE
  UNKNOWN
}

enum ServiceChargeType {
  LABOR
  SPARE_PARTS
  OTHER_COST
  DOWNTIME_RENT
  REPLACEMENT_RENT
}

enum ServiceChargeStatus {
  PENDING
  BILLED
  WAIVED
  COLLECTED
}

enum InventoryMovementType {
  PURCHASE
  RETURN
  ADJUSTMENT
  ISSUE_TO_SERVICE
  TRANSFER
  WRITE_OFF
  OPENING_STOCK
  PURCHASE_IN
  SERVICE_CONSUMPTION
  MANUAL_ADJUSTMENT
  SERVICE_RETURN
  DAMAGED_STOCK
}

enum RentalPauseStatus {
  ACTIVE
  RESUMED
  CANCELLED
}

enum DocumentType {
  ID_PROOF
  PAN
  AADHAAR
  ADDRESS_PROOF
  DRIVING_LICENSE
  VEHICLE_PERMIT
  INSURANCE
  REGISTRATION
  CONTRACT
  PVC
  BGV
  OTHER
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
  NOT_SUBMITTED
  UNDER_REVIEW
}

// ============================================================
// RBAC
// ============================================================
model Permission {
  id          String  @id @default(uuid(7))
  resource    String
  action      String
  description String?
  roles       Role[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id          String       @id @default(uuid(7))
  name        String       @unique
  permissions Permission[]
  users       User[]

  @@map("roles")
}

//p
model User {
  id           String        @id @default(uuid(7))
  name         String
  email        String?       @unique
  phoneNumber  String        @unique
  passwordHash String
  status       AccountStatus @default(ONBOARDING)
  lastLoginAt  DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  staffProfile Staff?
  riderProfile Rider?
  auditLogs    AuditLog[]

  rentalsCreated Rental[] @relation("RentalCreatedBy")
  rentalsClosed  Rental[] @relation("RentalClosedBy")

  invoicesApproved Invoice[] @relation("InvoiceApprovedBy")
  invoicesVoided   Invoice[] @relation("InvoiceVoidedBy")

  collectionsReceived   Collection[] @relation("CollectionReceivedBy")
  collectionsReconciled Collection[] @relation("CollectionReconciledBy")

  payoutsApproved     Payout[]             @relation("PayoutApprovedBy")
  depositsAuthorized  DepositTransaction[] @relation("DepositAuthorizedBy")
  ledgerCreated       LedgerEntry[]        @relation("LedgerCreatedBy")
  settlementsApproved RiderSettlement[]    @relation("SettlementApprovedBy")

  assignmentsCreated             VehicleDeployment[]     @relation("AssignmentCreatedBy")
  // serviceStatusChanges           ServiceStatusHistory[]          @relation("ServiceStatusChangedBy")
  // vehicleHubChanges              VehicleHubHistory[]             @relation("VehicleHubChangedBy")
  servicesReported               Service[]               @relation("ServiceReportedBy")
  servicesApproved               Service[]               @relation("ServiceApprovedBy")
  servicesAssigned               Service[]               @relation("ServiceAssignedTo")
  inventoryMoved                 InventoryMovement[]     @relation("InventoryMovedBy")
  // serviceResponsibilityApprovals ServiceResponsibilityApproval[] @relation("ServiceResponsibilityApprovedBy")
  rentalsPaused                  RentalPause[]           @relation("RentalPausedBy")
  rentalsResumed                 RentalPause[]           @relation("RentalResumedBy")
  replacementAssignmentsMade     ReplacementAssignment[] @relation("ReplacementAssignedBy")
  replacementAssignmentsReturned ReplacementAssignment[] @relation("ReplacementReturnedBy")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

//p
model Staff {
  id              String      @id @default(uuid(7))
  userId          String?     @unique
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  employeeCode    String?     @unique
  fullName        String
  phoneNumber     String?
  hubId           String?
  hub             Hub?        @relation(fields: [hubId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  jobTitle        String?
  status          StaffStatus @default(ACTIVE)
  statusChangedAt DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  documents Document[]

  @@index([hubId])
  @@map("staff")
}

//p
model Rider {
  id                    String    @id @default(uuid(7))
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  riderCode             String    @unique
  fullName              String
  phoneNumber           String?
  email                 String?
  dateOfBirth           DateTime? @db.Date
  gender                Gender?
  address               Json?     @db.JsonB
  emergencyContactName  String?
  emergencyContactPhone String?

  deliveryPartnerCode String? @unique // AML code or personal code
  bankAccountNumber   String?
  bankIfsc            String?
  bankHolderName      String?

  rentalType   RentalType?
  b2cMode      B2CMode?
  b2bRiderMgmt B2BRiderMgmt?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  hubId    String?
  hub      Hub?    @relation(fields: [hubId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  status          RiderStatus         @default(ONBOARDING)
  pvcStatus       VerificationStatus? @default(NOT_SUBMITTED)
  bgvStatus       VerificationStatus? @default(NOT_SUBMITTED)
  // add pvc and bgv status fields.
  onboardedAt     DateTime?           @db.Timestamptz(3)
  statusChangedAt DateTime?           @db.Timestamptz(3)
  version         Int                 @default(0) //? remove this maybe

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rentals                Rental[]
  assignments            VehicleDeployment[]
  deposits               Deposit[]
  collections            Collection[]
  settlements            RiderSettlement[]
  ledgerEntries          LedgerEntry[]
  payouts                Payout[]
  // verifications          RiderVerification[]
  // verificationHistory    RiderVerificationHistory[]
  documents              Document[]
  replacementAssignments ReplacementAssignment[]

  @@index([hubId])
  @@index([clientId])
  @@index([status])
  @@index([rentalType])
  @@index([b2cMode])
  @@index([b2bRiderMgmt])
  @@index([phoneNumber])
  @@index([email])
  @@map("riders")
}

//p
model Hub {
  id           String   @id @default(uuid(7))
  name         String   @unique
  city         String
  state        String
  hubCode      String   @unique
  address      Json?    @db.JsonB
  contactPhone String?
  contactEmail String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles          Vehicle[]
  staff             Staff[]
  riders            Rider[]
  rentals           Rental[]
  contracts         ClientContract[]
  assignments       VehicleDeployment[]
  inventoryBalances InventoryBalance[]
  movementsFrom     InventoryMovement[] @relation("MovementFromHub")
  movementsTo       InventoryMovement[] @relation("MovementToHub")
  movements         InventoryMovement[] @relation("MovementHub")

  @@map("hubs")
}

//p
model Vehicle {
  id                 String  @id @default(uuid(7))
  registrationNumber String  @unique @db.VarChar(15)
  hubId              String?
  hub                Hub?    @relation(fields: [hubId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  make               String?
  model              String?
  year               Int?
  color              String?

  vehicleType      String? // e.g. EV scooter / cargo
  batteryType      String?
  chargerProvided  Boolean?
  registrationType String? // commercial / private
  ownershipType    String? // owned / leased / financed

  vin             String?       @unique
  status          VehicleStatus @default(IDLE)
  acquiredAt      DateTime?     @db.Timestamptz(3)
  retiredAt       DateTime?     @db.Timestamptz(3)
  isActive        Boolean       @default(true)
  version         Int           @default(0)
  statusChangedAt DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  assignments                    VehicleDeployment[]
  // hubHistory                     VehicleHubHistory[]
  services                       Service[]
  replacementForServices         Service[]               @relation("ReplacementVehicle")
  inventoryMovements             InventoryMovement[]
  documents                      Document[]
  replacementAssignmentsOriginal ReplacementAssignment[] @relation("ReplacementOriginalVehicle")
  replacementAssignmentsProvided ReplacementAssignment[] @relation("ReplacementAssignedVehicle")

  @@index([hubId])
  @@index([status])
  @@map("vehicles")
}

//p
model ClientContract {
  id                  String           @id @default(uuid(7))
  contractNumber      String           @unique
  clientId            String
  client              Client           @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hubId               String?
  hub                 Hub?             @relation(fields: [hubId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  riderManagement     B2BRiderMgmt
  startDate           DateTime         @db.Timestamptz(3)
  endDate             DateTime?        @db.Timestamptz(3)
  vehicleCount        Int
  vehicleModels       String[]
  dailyRate           Decimal          @db.Decimal(14, 4)
  securityDeposit     Decimal?         @db.Decimal(14, 2) // per vehicle or per agreement, decided per contract
  billingFrequency    BillingFrequency
  minBillingDays      Int?
  graceDays           Int?
  paymentTermsDays    Int?
  replacementRules    String?
  downtimeRules       String?
  damageRecoveryRules String?
  taxDetails          Json?            @db.JsonB
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  rentals Rental[]

  @@index([clientId, startDate])
  @@map("client_contracts")
}

//p
model Client {
  id               String     @id @default(uuid(7))
  clientCode       String     @unique
  type             ClientType
  name             String
  companyName      String?
  contactPerson    String?
  email            String?
  phoneNumber      String?
  taxId            String?
  billingAddress   Json?      @db.JsonB
  paymentTermsDays Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  rentals                Rental[]
  invoices               Invoice[]
  deposits               Deposit[]
  collections            Collection[]
  riders                 Rider[]
  replacementAssignments ReplacementAssignment[]
  contracts              ClientContract[]

  @@index([type])
  @@index([isActive])
  @@index([phoneNumber])
  @@index([email])
  @@index([deletedAt])
  @@map("clients")
}

//p
model RateCard {
  id               String            @id @default(uuid(7))
  code             String            @unique
  name             String
  description      String?
  vehicleCategory  String?
  rentalType       RentalType?
  billingFrequency BillingFrequency?
  dailyRate        Decimal           @db.Decimal(14, 4)
  weeklyRate       Decimal?          @db.Decimal(14, 4)
  fortnightlyRate  Decimal?          @db.Decimal(14, 4)
  monthlyRate      Decimal?          @db.Decimal(14, 4)
  securityDeposit  Decimal?          @db.Decimal(14, 2)
  currency         String            @default("INR") @db.Char(3)
  effectiveFrom    DateTime          @db.Timestamptz(3)
  effectiveTo      DateTime?         @db.Timestamptz(3)
  isActive         Boolean           @default(true)
  terms            Json?             @db.JsonB
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  rentals Rental[]

  @@index([vehicleCategory])
  @@index([rentalType, billingFrequency])
  @@index([isActive])
  @@index([deletedAt])
  @@map("rate_cards")
}

//p
model Rental {
  id                      String            @id @default(uuid(7))
  rentalNumber            String            @unique
  rentalType              RentalType
  b2cMode                 B2CMode?
  b2bRiderMgmt            B2BRiderMgmt?
  clientId                String?
  client                  Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderId                 String?
  rider                   Rider?            @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hubId                   String?
  hub                     Hub?              @relation(fields: [hubId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rateCardId              String?
  rateCard                RateCard?         @relation(fields: [rateCardId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  startDate               DateTime          @db.Timestamptz(3)
  endDate                 DateTime?         @db.Timestamptz(3)
  expectedEndDate         DateTime?         @db.Timestamptz(3)
  status                  RentalStatus      @default(DRAFT)
  agreementRef            String?
  billingFrequency        BillingFrequency?
  collectionPeriod        CollectionPeriod  @default(MONTHLY)
  currency                String            @default("INR") @db.Char(3)
  dailyRate               Decimal?          @db.Decimal(14, 4)
  weeklyRate              Decimal?          @db.Decimal(14, 4)
  fortnightlyRate         Decimal?          @db.Decimal(14, 4)
  monthlyRate             Decimal?          @db.Decimal(14, 4)
  securityDepositRequired Decimal?          @db.Decimal(14, 2)

  version                Int       @default(0)
  notes                  String?
  activatedAt            DateTime? @db.Timestamptz(3)
  closedAt               DateTime? @db.Timestamptz(3)
  finalOutstandingAmount Decimal?  @db.Decimal(14, 2)
  finalDepositBalance    Decimal?  @db.Decimal(14, 2)

  createdById String?
  createdBy   User?           @relation("RentalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  closedById  String?
  closedBy    User?           @relation("RentalClosedBy", fields: [closedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contractId  String?
  contract    ClientContract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  assignments                         VehicleDeployment[]
  deposits                            Deposit[]
  collections                         Collection[]
  collectionDues                      RentalCollectionDue[]
  ledgerEntries                       LedgerEntry[]
  invoices                            Invoice[]
  invoiceLines                        InvoiceLine[]
  services                            Service[]
  settlementLines                     RiderSettlementLine[]
  pauses                              RentalPause[]
  replacementAssignmentsForOriginal   ReplacementAssignment[] @relation("ReplacementOriginalRental")
  replacementAssignmentsAsReplacement ReplacementAssignment[] @relation("ReplacementRental")

  @@index([clientId, status])
  @@index([riderId, status])
  @@index([hubId])
  @@index([contractId])
  @@index([startDate, endDate])
  @@index([status, collectionPeriod])
  @@map("rentals")
}

//p
model VehicleDeployment {
  id               String              @id @default(uuid(7))
  vehicleId        String
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderId          String?
  rider            Rider?              @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId         String?
  rental           Rental?             @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hubId            String?
  hub              Hub?                @relation(fields: [hubId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedById     String?
  assignedBy       User?               @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  startDate        DateTime            @db.Timestamptz(3)
  endDate          DateTime?           @db.Timestamptz(3)
  startOdometer    Int?
  endOdometer      Int?
  status           AssignmentStatus    @default(ACTIVE)
  reason           String?
  replacementForId String?
  replacementFor   VehicleDeployment?  @relation("DeploymentReplacement", fields: [replacementForId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacements     VehicleDeployment[] @relation("DeploymentReplacement")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([vehicleId, status])
  @@index([riderId, status])
  @@index([rentalId, status])
  @@index([hubId])
  @@map("vehicle_assignments")
}

//not considered as revenue. only held
model Deposit {
  id             String           @id @default(uuid(7))
  payerType      DepositPayerType
  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderId        String?
  rider          Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId       String?
  rental         Rental?          @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amountRequired Decimal          @db.Decimal(14, 2)
  status         DepositStatus    @default(REQUIRED)
  dueDate        DateTime?        @db.Timestamptz(3)
  version        Int              @default(0)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  transactions DepositTransaction[]

  @@unique([rentalId])
  @@index([clientId])
  @@index([riderId])
  @@index([status])
  @@map("deposits")
}

model DepositTransaction {
  id                    String                 @id @default(uuid(7))
  depositId             String
  deposit               Deposit                @relation(fields: [depositId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type                  DepositTransactionType
  direction             LedgerDirection
  amount                Decimal                @db.Decimal(14, 2)
  currency              String                 @default("INR") @db.Char(3)
  reference             String?
  reason                String?
  authorizedById        String?
  authorizedBy          User?                  @relation("DepositAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  collectionId          String?
  collection            Collection?            @relation(fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversesTransactionId String?                @unique
  reversesTransaction   DepositTransaction?    @relation("DepositReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedBy            DepositTransaction?    @relation("DepositReversal")
  idempotencyKey        String?                @unique
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)

  @@index([depositId, createdAt])
  @@index([collectionId])
  @@map("deposit_transactions")
}

// invoice not yet implemented
model Invoice {
  id                 String           @id @default(uuid(7))
  invoiceNumber      String           @unique
  kind               InvoiceKind      @default(CONSOLIDATED)
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId           String?
  rental             Rental?          @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  billingPeriodStart DateTime         @db.Timestamptz(3)
  billingPeriodEnd   DateTime         @db.Timestamptz(3)
  billingFrequency   BillingFrequency
  issueDate          DateTime         @default(now()) @db.Timestamptz(3)
  issuedAt           DateTime?        @db.Timestamptz(3)
  dueDate            DateTime         @db.Timestamptz(3)
  status             InvoiceStatus    @default(DRAFT)
  currency           String           @default("INR") @db.Char(3)
  subtotal           Decimal          @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal          @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal          @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(14, 2)
  version            Int              @default(0)
  notes              String?
  approvedById       String?
  approvedBy         User?            @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt         DateTime?        @db.Timestamptz(3)
  voidedById         String?
  voidedBy           User?            @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  voidedAt           DateTime?        @db.Timestamptz(3)
  voidReason         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@index([clientId, status, dueDate])
  @@index([rentalId])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id              String         @id @default(uuid(7))
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId        String?
  rental          Rental?        @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceChargeId String?        @unique
  serviceCharge   ServiceCharge? @relation(fields: [serviceChargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chargeType      ChargeType
  description     String
  quantity        Decimal?       @db.Decimal(14, 3)
  unitPrice       Decimal?       @db.Decimal(14, 4)
  lineAmount      Decimal        @db.Decimal(14, 2)
  periodStart     DateTime?      @db.Timestamptz(3)
  periodEnd       DateTime?      @db.Timestamptz(3)
  pricingSnapshot Json?          @db.JsonB
  createdAt       DateTime       @default(now())

  @@index([invoiceId])
  @@index([rentalId])
  @@map("invoice_lines")
}

model Collection {
  id              String               @id @default(uuid(7))
  payerType       CollectionPayerType
  clientId        String?
  client          Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderId         String?
  rider           Rider?               @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalId        String?
  rental          Rental?              @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalDueId     String?
  rentalDue       RentalCollectionDue? @relation(fields: [rentalDueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount          Decimal              @db.Decimal(14, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  receivedAt      DateTime             @default(now()) @db.Timestamptz(3)
  status          CollectionStatus     @default(PENDING)
  receivedById    String?
  receivedBy      User?                @relation("CollectionReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reconciledAt    DateTime?            @db.Timestamptz(3)
  reconciledById  String?
  reconciledBy    User?                @relation("CollectionReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  idempotencyKey  String               @unique
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  allocations         PaymentAllocation[]
  depositTransactions DepositTransaction[]

  @@unique([rentalId, referenceNumber])
  @@index([clientId, receivedAt])
  @@index([riderId, receivedAt])
  @@index([rentalId, receivedAt])
  @@index([rentalDueId])
  @@index([status])
  @@map("collections")
}

model RentalCollectionDue {
  id                String          @id @default(uuid(7))
  rentalId          String
  rental            Rental          @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  periodStart       DateTime        @db.Timestamptz(3)
  periodEnd         DateTime        @db.Timestamptz(3)
  dueDate           DateTime        @db.Timestamptz(3)
  amountDue         Decimal         @db.Decimal(14, 2)
  amountCollected   Decimal         @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal         @db.Decimal(14, 2)
  status            RentalDueStatus @default(PENDING)
  generatedAt       DateTime        @default(now()) @db.Timestamptz(3)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  collections Collection[]

  @@unique([rentalId, periodStart, periodEnd])
  @@index([rentalId, status, dueDate])
  @@index([status, dueDate])
  @@map("rental_collection_dues")
}
/*
ALTER TABLE ledger_entries ADD CONSTRAINT ledger_entries_party_chk
  CHECK (rental_id IS NOT NULL OR rider_id IS NOT NULL);
 Append-only money journal. One row per movement, never edited:
 - rental side (client/rider owes AML): rentalId set
 - rider side (AML owes rider): riderId set, settlementId when closed out
 One economic event can still be two rows. 
 When rent is deducted from rider earnings, 
 settlement code writes RENT_DEDUCTION (rider, DEBIT) 
 and COLLECTION_RECEIVED (rental, CREDIT) for the same amount. 
 Correct, but nothing enforces the pair balances — only idempotencyKey stops duplicates.
*/
model LedgerEntry {
  id          String          @id @default(uuid(7))
  entryType   LedgerEntryType
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("INR") @db.Char(3)
  occurredAt  DateTime        @db.Timestamptz(3)
  description String

  rentalId     String?
  rental       Rental?          @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riderId      String?
  rider        Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  settlementId String?
  settlement   RiderSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sourceType      String?
  sourceId        String?
  reversesEntryId String?      @unique
  reversesEntry   LedgerEntry? @relation("LedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedBy      LedgerEntry? @relation("LedgerEntryReversal")

  idempotencyKey String   @unique
  metadata       Json?    @db.JsonB
  createdById    String?
  createdBy      User?    @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  settlementLines RiderSettlementLine[]

  @@index([rentalId, occurredAt])
  @@index([riderId, occurredAt])
  @@index([settlementId])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

model PaymentAllocation {
  id           String     @id @default(uuid(7))
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoiceId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount       Decimal    @db.Decimal(14, 2)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model RiderSettlement {
  id                   String           @id @default(uuid(7))
  settlementNumber     String           @unique
  riderId              String
  rider                Rider            @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  periodStart          DateTime         @db.Timestamptz(3)
  periodEnd            DateTime         @db.Timestamptz(3)
  status               SettlementStatus @default(DRAFT)
  currency             String           @default("INR") @db.Char(3)
  grossEarnings        Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions      Decimal          @default(0) @db.Decimal(14, 2)
  netPayable           Decimal          @default(0) @db.Decimal(14, 2)
  shortfallAmount      Decimal          @default(0) @db.Decimal(14, 2)
  requiresManualReview Boolean          @default(false)
  calculationSnapshot  Json?            @db.JsonB
  version              Int              @default(0)
  approvedById         String?
  approvedBy           User?            @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt           DateTime?        @db.Timestamptz(3)
  paidAt               DateTime?        @db.Timestamptz(3)
  failureReason        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  lines         RiderSettlementLine[]
  payouts       Payout[]
  ledgerEntries LedgerEntry[]

  @@index([riderId, periodStart, periodEnd])
  @@index([status])
  @@map("rider_settlements")
}

model RiderSettlementLine {
  id            String             @id @default(uuid(7))
  settlementId  String
  settlement    RiderSettlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lineType      SettlementLineType
  direction     LedgerDirection
  amount        Decimal            @db.Decimal(14, 2)
  description   String
  rentalId      String?
  rental        Rental?            @relation(fields: [rentalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerEntryId String?            @unique
  ledgerEntry   LedgerEntry?       @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  referenceType String?
  referenceId   String?
  snapshot      Json?              @db.JsonB
  createdAt     DateTime           @default(now())

  @@index([settlementId])
  @@index([rentalId])
  @@index([ledgerEntryId])
  @@map("rider_settlement_lines")
}

model Payout {
  id              String           @id @default(uuid(7))
  riderId         String?
  rider           Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  settlementId    String?
  settlement      RiderSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount          Decimal          @db.Decimal(14, 2)
  status          PayoutStatus     @default(PENDING)
  approvedById    String?
  approvedBy      User?            @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt      DateTime?        @db.Timestamptz(3)
  paidAt          DateTime?        @db.Timestamptz(3)
  paymentMethod   PaymentMethod?
  referenceNumber String?
  idempotencyKey  String           @unique
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([riderId, status])
  @@index([settlementId])
  @@map("payouts")
}

