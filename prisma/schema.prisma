generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================
enum AccountStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum ClientType {
  INDIVIDUAL
  CORPORATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RentalType {
  B2C
  B2B
}

enum B2CMode {
  AML_RIDER
  INDIVIDUAL_RIDER
}

enum B2BRiderMgmt {
  CLIENT_MANAGED
  AML_MANAGED
}

//how often this client is billed, per the signed agreement
enum BillingFrequency {
  WEEKLY
  FORTNIGHTLY //14 days
  MONTHLY
}

// Collection period is intentionally separate from BillingFrequency. A rental
// may be billed daily but collected every 15 days, for example.
enum CollectionPeriod {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum RentalDueStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum RentalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ON_HOLD
  COMPLETED
  TERMINATED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  CANCELLED
}

enum VehicleStatus {
  IDLE
  DEPLOYED
  IN_SERVICE
  UNDER_REPAIR
  OUT_OF_SERVICE
  RETIRED
}

enum RiderStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  INACTIVE
  TERMINATED
}

enum EmploymentType {
  INTERN
  TRAINEE
  FULL_TIME
  PART_TIME
  CONSULTANT
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DepositPayerType {
  CLIENT
  RIDER
}

enum DepositStatus {
  REQUIRED
  PENDING_RECEIPT
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_REFUNDED
  REFUNDED
  FORFEITED
  CLOSED
}

enum DepositEntryType {
  RECEIPT
  REFUND
  DEDUCTION
  FORFEIT
  // ADJUSTMENT
  REVERSAL
}

enum InvoiceKind {
  CONSOLIDATED
  RENTAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum ChargeType {
  RENTAL
  SERVICE
  REPAIR
  REPLACEMENT
  PARTS
  DOWNTIME
  ADJUSTMENT
  CREDIT
  OTHER
}

enum CollectionPayerType {
  CLIENT
  RIDER
}

// What a receipt settles. A deposit receipt has no rental due.
enum CollectionPurpose {
  RENT
  DEPOSIT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PayStatementStatus {
  DRAFT
  PENDING_APPROVAL
  PAYABLE
  APPROVED
  PAID
  FAILED
  RECONCILED
  REVERSED
}

enum PayStatementLineType {
  DELIVERY_PAY
  RENT_DEDUCTION
  DEPOSIT_DEDUCTION
  // ADJUSTMENT
  OTHER_DEDUCTION
  PAYOUT_REVERSAL
  INCENTIVE
  REIMBURSEMENT
  ADVANCE
  ADVANCE_RECOVERY
}

// One ledger for both directions: money owed to AML by a client/rider
// (rent) and money owed by AML to a rider (delivery pay and other credits).
// entryType says which.
enum LedgerEntryType {
  RENT_CHARGED
  COLLECTION_RECEIVED
  // RENT_ADJUSTMENT
  DELIVERY_PAY
  RENT_DEDUCTION
  DEPOSIT_DEDUCTION
  // ADJUSTMENT
  PAYOUT
  REVERSAL
  OTHER
  INCENTIVE // credit to rider, adds to pay
  REIMBURSEMENT // credit to rider, adds to pay
  ADVANCE // debit when handed out
  ADVANCE_RECOVERY // optional, if you ever want a distinct recovery line
}

/**
 * - rental side: DEBIT increases what the customer owes, CREDIT reduces it
 * - rider side: CREDIT increases what AML owes, DEBIT reduces it
 */
enum LedgerDirection {
  CREDIT // rental side: amonut recieved. rider side: AML owes more
  DEBIT // rental side: cutomer owns more. rider side: paid/deducted
}

enum ServiceType {
  TECHNICAL
  PREVENTIVE
  ACCIDENT
  RIDER_DAMAGE
  OTHER
}

enum ServiceStatus {
  REPORTED
  APPROVED
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CLOSED
  CANCELLED
}

enum ResponsibleParty {
  AML
  RIDER
  CLIENT
  THIRD_PARTY
  INSURANCE
  UNKNOWN
}

enum ServiceChargeType {
  LABOR
  SPARE_PARTS
  OTHER_COST
  DOWNTIME_RENT
  REPLACEMENT_RENT
}

enum ServiceChargeStatus {
  PENDING
  BILLED
  WAIVED
  COLLECTED
}

enum InventoryMovementType {
  PURCHASE
  RETURN
  ADJUSTMENT
  ISSUE_TO_SERVICE
  TRANSFER
  WRITE_OFF
  OPENING_STOCK
  PURCHASE_IN
  SERVICE_CONSUMPTION
  MANUAL_ADJUSTMENT
  SERVICE_RETURN
  DAMAGED_STOCK
}

enum DocumentType {
  ID_PROOF
  PAN
  AADHAAR
  ADDRESS_PROOF
  DRIVING_LICENSE
  VEHICLE_PERMIT
  INSURANCE
  REGISTRATION
  CONTRACT
  PVC
  BGV
  OTHER
}

model Permission {
  id          String  @id @default(uuid(7))
  resource    String
  action      String
  description String?
  roles       Role[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id          String       @id @default(uuid(7))
  name        String       @unique
  permissions Permission[]
  users       User[]

  @@map("roles")
}

//p
model User {
  id           String        @id @default(uuid(7))
  email        String?       @unique
  phoneNumber  String        @unique
  passwordHash String
  status       AccountStatus @default(ONBOARDING)
  lastLoginAt  DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?     @db.Timestamptz(3)
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)

  staffProfile Staff?
  riderProfile Rider?
  auditLogs    AuditLog[]

  rentalsCreated Rental[] @relation("RentalCreatedBy")
  rentalsClosed  Rental[] @relation("RentalClosedBy")

  invoicesApproved Invoice[] @relation("InvoiceApprovedBy")
  invoicesVoided   Invoice[] @relation("InvoiceVoidedBy")

  collectionsReceived   Collection[] @relation("CollectionReceivedBy")

  statementsPaid     RiderPayStatement[] @relation("PayStatementPaidBy")
  depositsAuthorized DepositLedger[]     @relation("DepositAuthorizedBy")
  ledgerCreated      LedgerEntry[]       @relation("LedgerCreatedBy")
  statementsApproved RiderPayStatement[] @relation("PayStatementApprovedBy")

  assignmentsCreated             VehicleDeployment[]     @relation("AssignmentCreatedBy")
  // serviceStatusChanges           ServiceStatusHistory[]          @relation("ServiceStatusChangedBy")
  // vehicleHubChanges              VehicleHubHistory[]             @relation("VehicleHubChangedBy")
  servicesReported               Service[]               @relation("ServiceReportedBy")
  servicesApproved               Service[]               @relation("ServiceApprovedBy")
  servicesAssigned               Service[]               @relation("ServiceAssignedTo")
  inventoryMoved                 InventoryMovement[]     @relation("InventoryMovedBy")
  // serviceResponsibilityApprovals ServiceResponsibilityApproval[] @relation("ServiceResponsibilityApprovedBy")
  replacementAssignmentsMade     ReplacementAssignment[] @relation("ReplacementAssignedBy")
  replacementAssignmentsReturned ReplacementAssignment[] @relation("ReplacementReturnedBy")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

//p
model Staff {
  id              String      @id @default(uuid(7))
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  employeeCode    String?     @unique
  fullName        String
  gender          Gender
  dateOfBirth     DateTime?   @db.Date
  department      String?
  alternatePhone  String?
  address         Json?       @db.JsonB
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup      String?
  employmentType  EmploymentType?
  workMode        WorkMode?
  educationalQualification String?
  anniversary     DateTime?   @db.Date
  dateOfJoining   DateTime?   @db.Timestamptz(3)
  probationEndDate       DateTime? @db.Timestamptz(3)
  dateOfLastWorkingDay   DateTime? @db.Timestamptz(3)
  dateOfRelieving        DateTime? @db.Timestamptz(3)
  aadharNumber    String?     @unique
  panNumber       String?     @unique
  bankName        String?
  branch          String?
  bankAccountNumber String?
  bankIfsc        String?
  bankHolderName  String?
  hubId           String?
  hub             Hub?        @relation(fields: [hubId], references: [id], onDelete: Restrict)
  jobTitle        String?
  status          StaffStatus @default(ACTIVE)
  statusChangedAt DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?   @db.Timestamptz(3)

  documents Document[]

  @@index([hubId])
  @@map("staff")
}

//p
model Rider {
  id                    String    @id @default(uuid(7))
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  riderCode             String    @unique
  fullName              String
  dateOfBirth           DateTime? @db.Date
  gender                Gender?
  address               Json?     @db.JsonB
  emergencyContactName  String?
  emergencyContactPhone String?

  aadharNumber      String?   @unique
  panNumber         String?   @unique
  licenseNumber     String?
  medicalReportExpiryDate          DateTime? @db.Timestamptz(3)
  agreementDate                    DateTime? @db.Timestamptz(3)
  policeVerificationValidUpto      DateTime? @db.Timestamptz(3)
  backgroundVerificationExpiryDate DateTime? @db.Timestamptz(3)
  dateOfLastWorkingDay             DateTime? @db.Timestamptz(3)

  deliveryPartnerCode String? @unique // AML code or personal code
  bankName            String?
  branch              String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankHolderName      String?

  rentalType   RentalType
  b2cMode      B2CMode?
  b2bRiderMgmt B2BRiderMgmt?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  hubId    String?
  hub      Hub?    @relation(fields: [hubId], references: [id], onDelete: Restrict)

  status          RiderStatus @default(ONBOARDING)
  onboardedAt     DateTime?   @db.Timestamptz(3)
  statusChangedAt DateTime?   @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  rentals                Rental[]
  assignments            VehicleDeployment[]
  deposits               Deposit[]
  collections            Collection[]
  payStatements          RiderPayStatement[]
  ledgerEntries          LedgerEntry[]
  documents              Document[]
  replacementAssignments ReplacementAssignment[]

  @@index([hubId])
  @@index([clientId])
  @@index([status])
  @@index([rentalType])
  @@index([b2cMode])
  @@index([b2bRiderMgmt])
  @@map("riders")
}

//p
model Hub {
  id           String   @id @default(uuid(7))
  name         String   @unique
  city         String
  state        String
  hubCode      String   @unique
  address      Json?    @db.JsonB
  contactPhone String?
  contactEmail String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  vehicles          Vehicle[]
  staff             Staff[]
  riders            Rider[]
  rentals           Rental[]
  contracts         ClientContract[]
  assignments       VehicleDeployment[]
  inventoryBalances InventoryBalance[]
  movementsFrom     InventoryMovement[] @relation("MovementFromHub")
  movementsTo       InventoryMovement[] @relation("MovementToHub")
  movements         InventoryMovement[] @relation("MovementHub")

  @@map("hubs")
}

//p
model Vehicle {
  id                 String  @id @default(uuid(7))
  registrationNumber String  @unique @db.VarChar(15)
  hubId              String?
  hub                Hub?    @relation(fields: [hubId], references: [id], onDelete: Restrict)
  make               String?
  model              String?
  year               Int?
  color              String?

  vehicleType      String?
  vehicleCategory  String?
  batteryType      String?
  batteryCapacity  Int?
  nominalRange     Int?
  chargingOptions  String? // slow | fast
  chargerProvided  Boolean?
  noOfTyres        Int?
  tyres            Json?   @db.JsonB // [{ position, size, serialNumber, brand }]
  batteryNumber       String?
  batteryModelNumber  String?
  batteryBrand        String?
  registrationType String? // commercial / private
  ownershipType    String? // owned / leased / financed

  dateOfPurchase      DateTime? @db.Timestamptz(3)
  dateOfDelivery      DateTime? @db.Timestamptz(3)
  dateOfRegistration  DateTime? @db.Timestamptz(3)
  dateOfOperation     DateTime? @db.Timestamptz(3)
  warrantyStartDate   DateTime? @db.Timestamptz(3)
  warrantyEndDate     DateTime? @db.Timestamptz(3)
  telematicsExpiryDate         DateTime? @db.Timestamptz(3)

  // Current finance and insurance only; no history.
  loanProvider        String?
  emiAmount           Decimal? @db.Decimal(14, 2)
  tenurePeriod        Int? // months
  emiDueDate          DateTime? @db.Timestamptz(3)
  insurancePolicyNumber String?
  insuranceProvider     String?
  insurancePolicyType   String?
  insuranceValidFrom    DateTime? @db.Timestamptz(3)
  insuranceValidTo      DateTime? @db.Timestamptz(3)
  insurancePremiumAmount Decimal? @db.Decimal(14, 2)
  insuranceStatus        String?
  insuranceThirdParty    String?

  vin             String?       @unique
  status          VehicleStatus @default(IDLE)
  acquiredAt      DateTime?     @db.Timestamptz(3)
  retiredAt       DateTime?     @db.Timestamptz(3)
  isActive        Boolean       @default(true)
  statusChangedAt DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?     @db.Timestamptz(3)

  assignments                    VehicleDeployment[]
  services                       Service[]
  replacementForServices         Service[]               @relation("ReplacementVehicle")
  inventoryMovements             InventoryMovement[]
  documents                      Document[]
  replacementAssignmentsOriginal ReplacementAssignment[] @relation("ReplacementOriginalVehicle")
  replacementAssignmentsProvided ReplacementAssignment[] @relation("ReplacementAssignedVehicle")

  @@index([hubId])
  @@index([status])
  @@map("vehicles")
}

//p
model ClientContract {
  id                  String           @id @default(uuid(7))
  contractNumber      String           @unique
  clientId            String
  client              Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  hubId               String?
  hub                 Hub?             @relation(fields: [hubId], references: [id], onDelete: Restrict)
  riderManagement     B2BRiderMgmt
  startDate           DateTime         @db.Timestamptz(3)
  endDate             DateTime?        @db.Timestamptz(3)
  vehicleCount        Int
  vehicleModels       String[]
  dailyRate           Decimal          @db.Decimal(14, 4)
  securityDeposit     Decimal?         @db.Decimal(14, 2) // per vehicle or per agreement, decided per contract
  billingFrequency    BillingFrequency
  minBillingDays      Int?
  graceDays           Int?
  paymentTermsDays    Int?
  replacementRules    String?
  downtimeRules       String?
  damageRecoveryRules String?
  taxDetails          Json?            @db.JsonB
  notes               String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  rentals Rental[]

  @@index([clientId, startDate])
  @@map("client_contracts")
}

//p
model Client {
  id               String     @id @default(uuid(7))
  clientCode       String     @unique
  type             ClientType
  name             String
  companyName      String?
  contactPerson    String?
  email            String?
  phoneNumber      String?
  taxId            String?
  billingAddress   Json?      @db.JsonB
  paymentTermsDays Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?  @db.Timestamptz(3)

  rentals                Rental[]
  invoices               Invoice[]
  deposits               Deposit[]
  collections            Collection[]
  riders                 Rider[]
  replacementAssignments ReplacementAssignment[]
  contracts              ClientContract[]

  @@index([type])
  @@index([isActive])
  @@index([phoneNumber])
  @@index([email])
  @@index([deletedAt])
  @@map("clients")
}

//p
model RateCard {
  id              String      @id @default(uuid(7))
  code            String      @unique
  name            String
  description     String?
  vehicleCategory String?
  vehicleModel    String?
  rentalType      RentalType?

  dailyRate       Decimal     @db.Decimal(14, 4)
  weeklyRate      Decimal?    @db.Decimal(14, 4)
  fortnightlyRate Decimal?    @db.Decimal(14, 4)
  monthlyRate     Decimal?    @db.Decimal(14, 4)
  securityDeposit Decimal?    @db.Decimal(14, 2)

  isActive        Boolean     @default(true)
  terms           Json?       @db.JsonB
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?   @db.Timestamptz(3)

  @@index([vehicleCategory])
  @@index([rentalType])
  @@index([isActive])
  @@index([deletedAt])
  @@map("rate_cards")
}

//p
model Rental {
  id                      String           @id @default(uuid(7))
  rentalNumber            String           @unique
  rentalType              RentalType
  b2cMode                 B2CMode?
  b2bRiderMgmt            B2BRiderMgmt?
  clientId                String?
  client                  Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId                 String?
  rider                   Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict)
  hubId                   String
  hub                     Hub              @relation(fields: [hubId], references: [id], onDelete: Restrict)
  startDate               DateTime         @db.Timestamptz(3)
  endDate                 DateTime?        @db.Timestamptz(3)
  expectedEndDate         DateTime?        @db.Timestamptz(3)
  status                  RentalStatus     @default(DRAFT)
  statusChangedAt         DateTime?        @db.Timestamptz(3)
  // agreementRef            String?
  collectionPeriod        CollectionPeriod @default(MONTHLY)
  dailyRate               Decimal?         @db.Decimal(14, 4)
  weeklyRate              Decimal?         @db.Decimal(14, 4)
  fortnightlyRate         Decimal?         @db.Decimal(14, 4)
  monthlyRate             Decimal?         @db.Decimal(14, 4)
  securityDepositRequired Decimal?         @db.Decimal(14, 2)

  notes                  String?
  activatedAt            DateTime? @db.Timestamptz(3)
  closedAt               DateTime? @db.Timestamptz(3)
  finalOutstandingAmount Decimal?  @db.Decimal(14, 2)
  finalDepositBalance    Decimal?  @db.Decimal(14, 2)

  createdById String?
  createdBy   User?           @relation("RentalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedById  String?
  closedBy    User?           @relation("RentalClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  contractId  String?
  contract    ClientContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  assignments                         VehicleDeployment[]
  deposits                            Deposit[]
  dues                                RentalDue[]
  ledgerEntries                       LedgerEntry[]
  invoices                            Invoice[]
  invoiceLines                        InvoiceLine[]
  services                            Service[]
  payStatementLines                   RiderPayStatementLine[]
  replacementAssignmentsForOriginal   ReplacementAssignment[] @relation("ReplacementOriginalRental")
  replacementAssignmentsAsReplacement ReplacementAssignment[] @relation("ReplacementRental")

  @@index([clientId, status])
  @@index([riderId, status])
  @@index([hubId])
  @@index([contractId])
  @@index([startDate, endDate])
  @@index([status, collectionPeriod])
  @@map("rentals")
}

//p
model VehicleDeployment {
  id               String              @id @default(uuid(7))
  vehicleId        String
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  riderId          String?
  rider            Rider?              @relation(fields: [riderId], references: [id], onDelete: Restrict)
  rentalId         String?
  rental           Rental?             @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  hubId            String?
  hub              Hub?                @relation(fields: [hubId], references: [id], onDelete: Restrict)
  assignedById     String?
  assignedBy       User?               @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  startDate        DateTime            @db.Timestamptz(3)
  endDate          DateTime?           @db.Timestamptz(3)
  startOdometer    Int?
  endOdometer      Int?
  status           AssignmentStatus    @default(ACTIVE)
  reason           String?
  replacementForId String?
  replacementFor   VehicleDeployment?  @relation("DeploymentReplacement", fields: [replacementForId], references: [id], onDelete: Restrict)
  replacements     VehicleDeployment[] @relation("DeploymentReplacement")
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, status])
  @@index([riderId, status])
  @@index([rentalId, status])
  @@index([hubId])
  @@map("vehicle_deployments")
}

//not considered as revenue. only held p
model Deposit {
  id             String           @id @default(uuid(7))
  payerType      DepositPayerType
  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId        String?
  rider          Rider?           @relation(fields: [riderId], references: [id], onDelete: Restrict)
  rentalId       String?
  rental         Rental?          @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  amountRequired Decimal          @db.Decimal(14, 2)
  status         DepositStatus    @default(REQUIRED)
  dueDate        DateTime?        @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  ledgerEntries DepositLedger[]

  @@unique([rentalId])
  @@index([clientId])
  @@index([riderId])
  @@index([status])
  @@map("deposits")
}

//p
model DepositLedger {
  id              String             @id @default(uuid(7))
  depositId       String
  deposit         Deposit            @relation(fields: [depositId], references: [id], onDelete: Restrict)
  type            DepositEntryType
  direction       LedgerDirection
  amount          Decimal            @db.Decimal(14, 2)
  reference       String?  //UPI transaction id, cheque number, bank transfer reference, physical receipt number
  reason          String?
  authorizedById  String?
  authorizedBy    User?              @relation("DepositAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  collectionId    String?
  collection      Collection?        @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  payStatementId  String?
  payStatement    RiderPayStatement? @relation("DepositPayStatement", fields: [payStatementId], references: [id], onDelete: Restrict)
  reversesEntryId String?            @unique
  reversesEntry   DepositLedger?     @relation("DepositReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      DepositLedger?     @relation("DepositReversal")
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  @@index([depositId, createdAt])
  @@index([collectionId])
