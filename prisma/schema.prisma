  fromHub        Hub?                  @relation("MovementFromHub", fields: [fromHubId], references: [id], onDelete: Restrict)
  toHubId        String?
  toHub          Hub?                  @relation("MovementToHub", fields: [toHubId], references: [id], onDelete: Restrict)
