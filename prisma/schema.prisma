generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model Permission {
  id          String  @id @default(uuid(7))
  resource    String // e.g., "user", "role"
  action      String // e.g., "create", "read", "update", "delete"
  description String?

  roles Role[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id   String @id @default(uuid(7))
  name String @unique

  permissions Permission[]
  users       User[]

  @@map("roles")
}

model User {
  id          String        @id @default(uuid(7))
  name        String
  email       String?       @unique
  phoneNumber String       @unique
  password    String
  status      AccountStatus @default(ONBOARDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String

  employeeProfiles Employee[]
  driverProfiles Driver[]
  auditLogs AuditLog[]

  @@map("users")
}

model Driver{
  id  String  @id @default(uuid(7))
  name String @unique

  user User @relation(fields: [userId], references: [id])
  userId String

  @@map("drivers")
}

model Employee{
  id  String  @id @default(uuid(7))
  name String @unique

  user User @relation(fields: [userId], references: [id])
  userId String
  @@map("employees")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  userName String
  userRole String

  action    String
  ipAddress String?
  userAgent String?
  status    String  @default("SUCCESS")

  resource   String
  resourceId String

  changes Json?   @db.JsonB
  summary String?

  @@index([userId])
  @@index([resourceId])
  @@index([resource])
  @@map("audit_logs")
}

model hub {
  id  String  @id @default(uuid(7))

  @@map("hubs")
}

model vehicle {
  id  String  @id @default(uuid(7))

  registrationNumber String @unique @db.VarChar(10)
  //permit?
  // insurance
  @@map("vehicles")
}

