# Server
PORT=3030
NODE_ENV=dev
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL + Redis
DATABASE_URL=postgresql://user:password@localhost:5432/your_db
REDIS_URL=redis://localhost:6379

# JWT secrets must be long random values in every real environment.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Optional isolated database URL used by npm run test:integration.
# The integration suite truncates tables in this schema; never point it at data
# you need to keep.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/your_db?schema=anantha_test

# Document storage. local writes to STORAGE_LOCAL_DIR outside the database.
# Production should use a private S3-compatible adapter (see docs/riders.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_MAX_FILE_BYTES=10485760

# Password reset. Tokens are hashed at rest and are single-use.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MIN_LENGTH=8


# Optional SMTP settings reserved for an SMTP provider adapter.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
