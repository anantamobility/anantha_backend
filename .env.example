PORT=3030
DATABASE_URL=postgresql://user:password@localhost:5432/your_db
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# "prod" enables secure cookies (not "production")
NODE_ENV=dev
REDIS_URL=redis://localhost:6379

# Document storage. local writes to STORAGE_LOCAL_DIR outside the database.
# Production should use a private S3-compatible adapter (see docs/riders.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_MAX_FILE_BYTES=10485760